# Mirrors ../wezterm/wezterm.lua. Keep the two in sync.

# Colors from the Datalumina Herdr guide (Dave's setup):
# https://learn.datalumina.com/docs/herdr/ghostty
background = #1D1E27
foreground = #FDFDFD
palette = 0=#282A2B
palette = 1=#F3977F
palette = 2=#5ADECD
palette = 3=#F272A2
palette = 4=#886F97
palette = 5=#C574DD
palette = 6=#79E6F3
palette = 7=#FDFDFD
palette = 8=#415844
palette = 9=#FF4971
palette = 10=#18E3C8
palette = 11=#FF8037
palette = 12=#556FFF
palette = 13=#B0D143
palette = 14=#3FDCEE
palette = 15=#BEBEC1

# No font-family: Ghostty's built-in JetBrains Mono with Nerd Font icons, as
# in the guide.
font-size = 14

# WezTerm's RESIZE decorations: no titlebar, but a normal resizable frame.
# Ghostty draws its tab bar in the titlebar, so this also hides tabs the way
# hide_tab_bar_if_only_one_tab did; Herdr owns tabs anyway.
macos-titlebar-style = hidden

# Let these Cmd keys reach Herdr and Neovim (see ../herdr/config.toml).
keybind = super+t=unbind
keybind = super+w=unbind
keybind = super+k=unbind
keybind = super+e=unbind
keybind = super+shift+g=unbind

# Both Option keys send Alt, as in the Datalumina guide.
macos-option-as-alt = true

# 100,000 lines of history. The guide writes `scrollback-limit = 100000`, but
# Ghostty reads that as 100 KB, far below its 50 MB default, so set lines.
scrollback-limit-lines = 100000

# Cursor and padding from the Datalumina guide (Dave's setup).
cursor-style = bar
cursor-style-blink = false
window-padding-x = 10
window-padding-y = 8

# Ghostty has no unfocused-window dimming, so WezTerm's window-focus-changed
# handler has no equivalent. Splits inside a window still fade when unfocused.
